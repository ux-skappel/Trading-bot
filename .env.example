# --- SAFETY ---
# Live trading is OFF by default. Even if set to true, the system still requires
# manual confirmation in the dashboard/CLI before any order is placed.
LIVE_TRADING=false
REQUIRE_MANUAL_CONFIRMATION=true

# --- MODE ---
# analysis | paper | live
TRADING_MODE=paper
HUMAN_APPROVAL_MODE=true

# --- X / TWITTER (official API only) ---
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- REDDIT (official API only) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trading-bot-mvp/0.1
REDDIT_SUBREDDITS=stocks,wallstreetbets,CryptoCurrency,investing

# --- MARKET DATA ---
# yfinance needs no key. Add an API key here if you switch to a paid provider.
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_API_KEY=

# --- BROKER (future integrations, NOT enabled by default) ---
BROKER=paper           # paper | alpaca | ibkr | binance | coinbase
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- DATABASE ---
DATABASE_URL=sqlite:///./trading_bot.db

# --- LOGGING ---
LOG_LEVEL=INFO

# --- COPY TRADING (step 1: read-only Telegram + paper trades, no real orders) ---
# Create an app at https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=            # e.g. +4791234567 (used only to log in)
COPY_CHAT=                 # group/channel name, @username, link or id (see: copy chats)
COPY_AUTHOR=               # his @username or id (see: copy authors); empty for a channel
COPY_TOPIC=                # topic ids/titles, comma-separated, in a group with topics (see: copy topics)
COPY_START_EQUITY=10000    # paper account in USD
COPY_DEFAULT_MARGIN_PCT=0.10   # margin per trade when his post gives no size/risk
COPY_MAX_SLIPPAGE_PCT=0.01     # buy at once if within 1% of his entry, else wait for it
COPY_ENTRY_TIMEOUT_HOURS=24    # give up on a waiting entry after this
COPY_MAX_OPEN_DELAY_MINUTES=2  # live: skip a buy the bot sees later than this after his post
